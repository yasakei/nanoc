        if(relocation.section == 3) { sectionOffset = arrays.at(offsets,2) }
        var location = sectionOffset + relocation.offset
        nativeApplyRelocation(bytes,location,relocation.kind,symbolAddress,relocation.addend,baseAddress + location)
        index = index + 1
    }
    libraryIndex = 0
    while(libraryIndex < arrays.length(needed)) { nativeDynamicEntry(dynamic.bytes,1,arrays.at(needed,libraryIndex)); libraryIndex = libraryIndex + 1 }
    nativeDynamicEntry(dynamic.bytes,4,baseAddress + arrays.at(offsets,3))
    nativeDynamicEntry(dynamic.bytes,5,baseAddress + arrays.at(offsets,5))
    nativeDynamicEntry(dynamic.bytes,6,baseAddress + arrays.at(offsets,4))
    nativeDynamicEntry(dynamic.bytes,10,arrays.length(dynstr.bytes))
    nativeDynamicEntry(dynamic.bytes,11,24)
    nativeDynamicEntry(dynamic.bytes,7,baseAddress + arrays.at(offsets,6))
    nativeDynamicEntry(dynamic.bytes,8,arrays.length(rela.bytes))
    nativeDynamicEntry(dynamic.bytes,9,24)
    nativeDynamicEntry(dynamic.bytes,24,0)
    nativeDynamicEntry(dynamic.bytes,0,0)
    index = 0
    while(index < arrays.length(dynamic.bytes)) { bytes[arrays.at(offsets,9) + index] = arrays.at(dynamic.bytes,index); index = index + 1 }
