        var link = 0; var info = 0; var entrySize = 0
        if(index == 3) { link = 5; entrySize = 4 }
        if(index == 4) { link = 6; info = 1; entrySize = 24 }
        if(index == 6) { link = 5; entrySize = 24 }
        if(index == 9) { link = 6; entrySize = 16 }
        var address = 0
