}
fun nativeLink(view mut NativeObject O, view string path, view array[string] libraries) {
    var index = 0
    while(index < arrays.length(O.symbols)) {
        if(O.symbols[index].name == "_start" && O.symbols[index].section != 0) { throw "nanoc: _start is reserved by native startup" }
        index = index + 1
    }
    var startup = nativeAssemble(".text\n.globl _start\n.type _start, @function\n_start:\nxorl %ebp, %ebp\nmovq %rdx, %r9\npopq %rsi\nmovq %rsp, %rdx\nandq $-16, %rsp\npushq %rax\npushq %rsp\nxorl %r8d, %r8d\nxorl %ecx, %ecx\nleaq main(%rip), %rdi\ncall __libc_start_main\nhlt\n")
    nativeMerge(O,startup,-1)
    nativeWriteExecutable(O,path,libraries)
}
