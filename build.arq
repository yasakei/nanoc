import "tests/arq/helpers.arq"
import "tests/arq/preprocessor.arq"
import "tests/arq/compiler.arq"
import "tests/arq/language.arq"
import "tests/arq/native.arq"
import "tests/arq/archive.arq"
import "tests/arq/got.arq"
import "tests/arq/symbols.arq"

task build {
    run "ntsc build"
}

task test_smoke after build {
    let workspace = test_workspace("smoke")
    let nanoc = absolute("build/debug/nanoc")
    for suite in ["stdio", "headers", "variadic", "int_width"] {
        let executable = absolute(workspace + "/" + suite)
        checked(workspace, nanoc, ["-o", executable, "tests/c/" + suite + ".c"])
        checked(workspace, executable, [])
    }
    finish_workspace(workspace)
    print("standard I/O, headers, variadic functions, integer widths: ok")
}

task test after test_preprocessor, test_driver, test_abi, test_smoke, test_language, test_rejections, test_native, test_archive, test_got, test_symbols {}

task check {
    test
}
