task test_language after build {
    let workspace = test_workspace("language")
    let nanoc = absolute("build/debug/nanoc")
    let local = absolute(workspace + "/local")
    let reference = absolute(workspace + "/reference")
    let tcc = env("TCC")
    let tcc_lib = env("TCC_LIB")
    for suite in ["integer64", "assignment_expr", "floating_expr", "initializers", "static_storage", "long_double"] {
        let source = "tests/c/" + suite + ".c"
        checked(workspace, "gcc", ["-std=c11", "-O0", source, "-o", reference])
        checked(workspace, reference, [])
        checked(workspace, nanoc, [source, "-o", local])
        checked(workspace, local, [])
        if tcc != "" {
            if tcc_lib == "" {
                checked(workspace, tcc, [source, "-o", reference])
            } else {
                checked(workspace, tcc, ["-B" + tcc_lib, source, "-o", reference])
            }
            checked(workspace, reference, [])
        }
    }
    # This TinyCC checkout rejects trailing commas in scalar braces; retain
    # the C11 regression using GCC as the reference rather than dropping it.
    write(workspace + "/scalar-braces.c", "int main(void) { int value = {42,}; return value - 42; }\n")
    let scalar_source = absolute(workspace + "/scalar-braces.c")
    checked(workspace, "gcc", ["-std=c11", scalar_source, "-o", reference])
    checked(workspace, reference, [])
    checked(workspace, nanoc, [scalar_source, "-o", local])
    checked(workspace, local, [])
    finish_workspace(workspace)
    print("64-bit arithmetic, assignments, pointers, floating comparisons, initializers, static storage: ok")
}

task test_rejections after build {
    let workspace = test_workspace("rejections")
    let nanoc = absolute("build/debug/nanoc")
    let source = absolute(workspace + "/invalid.c")
    let target = absolute(workspace + "/invalid.o")
    for input in [
        "int main(void) { int values[0]; return 0; }",
        "int main(void) { int values[2] = {1, 2, 3}; return 0; }",
        "int values[2] = {1, 2, 3};",
        "int main(void) { int values[2] = {[3] = 1}; return 0; }",
        "int values[2] = {[3] = 1};",
        "int main(void) { char text[2] = \"abc\"; return 0; }",
        "char text[2] = \"abc\";",
        "int main(void) { int values[]; return 0; }",
        "int values[];",
        "int main(void) { int values[2][]; return 0; }",
        "int main(void) { int a[2], b[2]; a = b; return 0; }",
        "struct Item { int value; }; int main(void) { struct Item item = {.missing = 1}; return 0; }",
        "struct Item { int value; }; struct Item item = {.missing = 1};",
        "struct Item { int value; }; int main(void) { struct Item item = {1, 2}; return 0; }",
        "struct Item { int value; }; struct Item item = {1, 2};",
        "struct Item { int value; }; int main(void) { struct Item item; item = 1; return 0; }",
        "int get(void); int main(void) { static int value = get(); return value; }",
        "int main(void) { int value = 42; static int copy = value; return copy; }",
        "int main(void) { int value = 42; static int *pointer = &value; return *pointer; }",
        "int main(void) { static extern int value; return 0; }",
        "int main(void) { static int get(void); return 0; }",
        "struct Item { int value; }; struct Item identity(struct Item value) { return value; } int main(void) { identity(1); return 0; }",
        "struct Item { int value; }; int scalar(int value) { return value; } int main(void) { struct Item value = {1}; scalar(value); return 0; }",
        "struct Item { int value; }; struct Item identity(struct Item value) { return 1; }",
        "struct Item { unsigned int value:3; }; struct Item identity(struct Item value) { return value; }"
    ] {
        write(workspace + "/invalid.c", input + "\n")
        expect_exit(workspace, nanoc, ["-c", source, "-o", target], 1)
        require(!exists(workspace + "/invalid.o"), "rejected source produced an object")
    }
    finish_workspace(workspace)
    print("invalid bounds/initializers, static storage and incompatible aggregate ABI: rejected")
}
